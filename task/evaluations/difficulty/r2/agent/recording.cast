[221.877487, "i", "python3 - <<'PY'\nimport csv, json, os\nfor f in ['feature_matrix_audit.csv','micaform_switch_note.md','results.json']:\n    print(f, os.path.getsize(f))\nwith open('feature_matrix_audit.csv') as fh:\n    rows=list(csv.DictReader(fh))\nprint('csv_rows', len(rows))\nprint('ids', [r['feature_id'] for r in rows])\nwith open('results.json') as fh:\n    data=json.load(fh)\nprint('json_keys', sorted(data.keys()))\nprint('json_values', data)\nprint('note_words', len(open('micaform_switch_note.md').read().split()))\nPY\n"]
